{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "velora-shop",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "velora-shop",
      // TODO(operator): replace with the real ID from `wrangler d1 create velora-shop`
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SITE_URL": "https://velorapadel.ch"
  }
  // Secrets (never commit): PAYREXX_INSTANCE, PAYREXX_API_KEY, RESEND_API_KEY
  // -> local: .dev.vars ; production: `wrangler secret put <NAME>`
}
